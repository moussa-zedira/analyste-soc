# ──────────────────────────────────────────────────────────
# Cyber Defense Dashboard – Environment Variables
# Copy this file to .env and adjust values for your setup.
# docker-compose.yml already sets these defaults for Docker.
# ──────────────────────────────────────────────────────────

# Environment: "dev" or "prod"
ENV=dev

# ── Database (PostgreSQL) ─────────────────────────────────
DATABASE_URL=postgresql+psycopg2://siem:siem@localhost:5432/siem

# ── Redis ─────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── API Security ──────────────────────────────────────────
API_KEY=change-me
API_KEY_HEADER=X-API-Key
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

# ── Agent ─────────────────────────────────────────────────
API_BASE_URL=http://localhost:8000

# ── GeoIP (MaxMind GeoLite2) ─────────────────────────────
GEOIP_DB_PATH=/app/data/GeoLite2-City.mmdb

# ── Ollama LLM (chatbot) ─────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# ── Triage ────────────────────────────────────────────────
TRIAGE_ENABLED=true
MIN_SEVERITY=medium

# ── Webhook notifications ────────────────────────────────
WEBHOOK_ENABLED=false
WEBHOOK_URL=

# ── SMTP (email alerts) ──────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=siem@example.com

# ── Slack (alerts) ────────────────────────────────────────
SLACK_WEBHOOK_URL=

# ── Frontend ──────────────────────────────────────────────
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
NEXT_PUBLIC_API_KEY=change-me
