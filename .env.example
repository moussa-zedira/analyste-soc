# ──────────────────────────────────────────────────────────
# Cyber Defense Dashboard – Environment Variables
# Copy this file to .env and adjust values for your setup.
# docker-compose.yml already sets these defaults for Docker.
# ──────────────────────────────────────────────────────────

# Environment: "dev" or "prod"
ENV=dev

# ── Module offensif (red team / pentest) ──────────────────
# true  = plateforme complète pentest + SIEM (défaut, ~110 routers offensifs)
# false = instance blue team / SOC pur : aucun router offensif monté,
#         démarrage plus léger, CI/surface réduite. Réversible à chaud.
ENABLE_OFFENSIVE=true

# Auto-Exploit (moteur autonome) — whitelist optionnelle des cibles autorisées.
# Si défini, SEULES ces cibles passent le scope guard en mode live (defense in
# depth, en plus de la blacklist .gov/.mil/tiers). Formats : FQDN exact,
# suffixe (.lab.local), ou CIDR (10.0.0.0/8), séparés par des virgules.
# Vide = pas de whitelist (seules les blacklists s'appliquent).
AUTOEXPLOIT_ALLOWED_TARGETS=

# ── Database (PostgreSQL) ─────────────────────────────────
# Generate a strong password: python -c "import secrets; print(secrets.token_urlsafe(20))"
POSTGRES_USER=siem
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
POSTGRES_DB=siem
DATABASE_URL=postgresql+psycopg2://siem:REPLACE_WITH_STRONG_PASSWORD@postgres:5432/siem

# ── Redis ─────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── API Security ──────────────────────────────────────────
# REQUIS pour le moteur Auto-Exploit live : les phases s'appellent entre elles
# via HTTP interne en envoyant cet API_KEY en X-API-Key. S'il est vide, le live
# loggue "API_KEY env var not set" et ne récolte aucun finding.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=REPLACE_WITH_RANDOM_TOKEN_32B
API_KEY_HEADER=X-API-Key
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=REPLACE_WITH_RANDOM_TOKEN_48B
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

# Bootstrap admin password (leave empty to auto-generate at first start)
ADMIN_BOOTSTRAP_PASSWORD=

# ── Agent ─────────────────────────────────────────────────
API_BASE_URL=http://localhost:8000

# ── GeoIP (MaxMind GeoLite2) ─────────────────────────────
GEOIP_DB_PATH=/app/data/GeoLite2-City.mmdb

# ── Ollama LLM (chatbot) ─────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
# Modèle de fallback assistant. Défaut produit : qwen2.5-coder:32b (≈20 Go VRAM).
# Alternatives plus légères : qwen2.5-coder:7b, llama3.2
OLLAMA_MODEL=qwen2.5-coder:32b

# ── Triage ────────────────────────────────────────────────
TRIAGE_ENABLED=true
MIN_SEVERITY=medium

# ── Webhook notifications ────────────────────────────────
WEBHOOK_ENABLED=false
WEBHOOK_URL=

# ── SMTP (email alerts) ──────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=siem@example.com

# ── Slack (alerts) ────────────────────────────────────────
SLACK_WEBHOOK_URL=

# ── Frontend ──────────────────────────────────────────────
# NEXT_PUBLIC_* vars are exposed to the browser. NEVER put secrets here.
# The API key is injected server-side via /api/proxy route handler
# (using INTERNAL_API_KEY which equals API_KEY above).
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
INTERNAL_API_BASE_URL=http://api:8000
INTERNAL_API_KEY=${API_KEY}

# ── Observabilite (optionnel) ────────────────────────────
# Tracing OpenTelemetry. Si vide -> tracing desactive (zero overhead).
# Exemple Jaeger/OTel-collector : http://otel-collector:4317
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_INSECURE=true
OTEL_SERVICE_NAME=cyberdef-api
OTEL_TRACES_SAMPLER_RATIO=1.0

# Grafana (overlay docker-compose.monitoring.yml)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
