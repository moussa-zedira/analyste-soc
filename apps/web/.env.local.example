# NEXT_PUBLIC_* variables ARE exposed to the browser bundle. NEVER put secrets here.
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000

# Server-only variables (used by the /api/proxy route handler to inject the
# X-API-Key header server-side). Must equal API_KEY from the backend's .env.
INTERNAL_API_BASE_URL=http://127.0.0.1:8000
INTERNAL_API_KEY=REPLACE_WITH_API_KEY_FROM_BACKEND_ENV
