# Environment: "dev" or "prod"
ENV=dev

# Database (PostgreSQL recommended for production)
DATABASE_URL=postgresql+psycopg2://siem:siem@localhost:5432/siem

# Redis (cache, Celery broker, pub/sub)
REDIS_URL=redis://localhost:6379/0

# API key for header-based authentication (CHANGE THIS in production)
API_KEY=change-me
API_KEY_HEADER=X-API-Key

# JWT Authentication
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

# Webhook notifications
WEBHOOK_URL=
WEBHOOK_ENABLED=false

# Ollama LLM (chatbot)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Triage
TRIAGE_ENABLED=true
MIN_SEVERITY=medium

# GeoIP (MaxMind GeoLite2)
GEOIP_DB_PATH=/app/data/GeoLite2-City.mmdb

# SMTP (email alerts)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=siem@example.com

# Slack (alerts)
SLACK_WEBHOOK_URL=
